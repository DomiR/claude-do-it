{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"printWidth": 120,
	"useTabs": true,
	"tabWidth": 2,
	"semi": true,
	"singleQuote": true,
	"jsxSingleQuote": true,
	"trailingComma": "none",
	"arrowParens": "always",
	"bracketSpacing": true,
	"endOfLine": "lf",
	"ignorePatterns": ["**/dist/**", "**/node_modules/**", ".claude/**", "repos/**", "skill/**", "**/*.md"]
}
